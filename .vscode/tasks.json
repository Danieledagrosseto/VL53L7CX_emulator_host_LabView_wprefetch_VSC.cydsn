{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PSoC Creator: Build Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\psoc-creator.ps1",
        "-Action", "Build",
        "-Configuration", "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PSoC Creator: Build Release",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\psoc-creator.ps1",
        "-Action", "Build",
        "-Configuration", "Release"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PSoC Creator: Rebuild",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\psoc-creator.ps1",
        "-Action", "Rebuild",
        "-Configuration", "${input:configuration}"
      ],
      "problemMatcher": ["$gcc"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PSoC Creator: Clean",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\psoc-creator.ps1",
        "-Action", "Clean",
        "-Configuration", "${input:configuration}"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "PSoC Creator: Open Workspace",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\.vscode\\psoc-creator.ps1",
        "-Action", "Open"
      ],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ],
  "inputs": [
    {
      "id": "configuration",
      "type": "pickString",
      "description": "PSoC Creator build configuration",
      "options": ["Debug", "Release"],
      "default": "Debug"
    }
  ]
}
